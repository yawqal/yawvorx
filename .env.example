# Copy this file to .env.local (local) or add each line in Vercel > Settings > Environment Variables.
# Never put real secrets in this example file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=REPLACE_WITH_VALID_EMAIL
NEXT_PUBLIC_WHATSAPP_NUMBER=REPLACE_WITH_COUNTRY_CODE_AND_NUMBER
NEXT_PUBLIC_MANUAL_PAYMENT_INSTRUCTIONS=REPLACE_WITH_PAYMENT_INSTRUCTIONS

# ---- Supabase (Phase 4) ----
# Dashboard: open your project, tap "Connect" (or Project Settings > API Keys). Copy the Project URL and the PUBLISHABLE key.
# Older projects may show an "anon" key instead: it can be used in the PUBLISHABLE_KEY line.
# NEVER paste a "secret" or "service_role" key anywhere in this project's NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=REPLACE_WITH_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
